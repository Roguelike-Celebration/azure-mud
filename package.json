{
  "name": "azure-mud",
  "version": "1.0.0",
  "description": "",
  "homepage": "https://github.com/Roguelike-Celebration/azure-mud",
  "scripts": {
    "dev": "parcel *.html",
    "build": "rm -rf ./dist && parcel build *.html --public-url ./ --dist-dir ./dist && cp CNAME dist && rsync -r images dist",
    "deploy": "npm run build; cp CNAME dist; gh-pages -d dist",
    "deploy-server": "pushd ./functions; npm run deploy; popd",
    "typecheck": "rc=0; npm run typecheck-frontend || rc=1; npm run typecheck-server || rc=1; exit $rc",
    "typecheck-frontend": "tsc --noEmit",
    "typecheck-server": "tsc --noEmit -p server",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.tsx\" \"server/**/*.ts\" lintLinks.ts",
    "lint-fix": "eslint \"src/**/*.ts\" \"src/**/*.tsx\" \"server/**/*.ts\" lintLinks.ts --fix",
    "lint-rooms": "ts-node lintLinks.ts",
    "lint-bash": "cd tools && shellcheck grin findd lib/bash/*.sh"
  },
  "author": "",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "dependencies": {
    "@microsoft/signalr": "^6.0.10",
    "ace-builds": "^1.5.3",
    "axios": "^0.21.2",
    "confetti-js": "^0.0.18",
    "firebase": "8.10.0",
    "firebaseui": "^5.0.0",
    "immer": "^9.0.15",
    "localforage": "^1.9.0",
    "lodash": "^4.17.21",
    "microsoft-cognitiveservices-speech-sdk": "^1.15.0",
    "node-emoji": "^1.10.0",
    "react": "^17",
    "react-ace": "^10.1.0",
    "react-contextmenu": "git://github.com/Roguelike-Celebration/react-contextmenu#master",
    "react-dom": "^17",
    "react-firebaseui": "^5.0.2",
    "react-icons": "^3.10.0",
    "react-linkify": "^1.0.0-alpha",
    "react-mentions": "^4.4.7",
    "react-page-visibility": "^6.4.0",
    "react-tooltip": "^4.2.8",
    "request": "^2.88.2",
    "ts-node": "^10",
    "twilio-video": "^2.8.0",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@types/lodash": "4.14.182",
    "@types/node-emoji": "1.8.1",
    "@types/react": "^17",
    "@types/react-dom": "^17",
    "@types/react-linkify": "1.0.1",
    "@types/react-mentions": "4.1.6",
    "@types/react-page-visibility": "6.4.1",
    "@types/redis": "^2.8.25",
    "@types/tracery-grammar": "^2.7.4",
    "@types/twilio-video": "^2.7.3",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.0",
    "eslint": "^7.6.0",
    "eslint-config-standard": "^14.1.1",
    "eslint-plugin-import": "^2.22.0",
    "eslint-plugin-jsx-a11y": "^6.3.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^4.2.1",
    "eslint-plugin-react": "^7.20.5",
    "eslint-plugin-standard": "^4.0.1",
    "events": "^3.3.0",
    "gh-pages": "^3.1.0",
    "https-browserify": "^1.0.0",
    "parcel": "2.12.0",
    "process": "^0.11.10",
    "punycode": "^1.4.1",
    "querystring-es3": "^0.2.1",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "typescript": "5.3.3",
    "url": "^0.11.0",
    "util": "^0.12.4"
  },
  "overrides": {
    "node-releases": "2.0.44"
  }
}

{
  "name": "azure-mud",
  "version": "1.0.0",
  "description": "",
  "homepage": "https://github.com/Roguelike-Celebration/azure-mud",
  "scripts": {
    "dev": "parcel --no-autoinstall *.html",
    "build": "rm -rf ./dist && parcel build --no-autoinstall *.html --public-url ./ --dist-dir ./dist && rsync -r images dist",
    "deploy": "echo \"ERROR: 'npm run deploy' is retired. (It used the old GH Pages deployment.) Use GitHub Actions instead now.\"; exit 1",
    "typecheck": "rc=0; npm run typecheck-frontend || rc=1; npm run typecheck-server || rc=1; exit $rc",
    "typecheck-frontend": "tsc --noEmit",
    "typecheck-server": "tsc --noEmit -p server",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.tsx\" \"server/**/*.ts\" lintLinks.ts",
    "lint-fix": "eslint \"src/**/*.ts\" \"src/**/*.tsx\" \"server/**/*.ts\" lintLinks.ts --fix",
    "lint-rooms": "ts-node lintLinks.ts",
    "lint-bash": "./tools/lint-bash"
  },
  "author": "",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "dependencies": {
    "@microsoft/signalr": "^6.0.10",
    "ace-builds": "^1.5.3",
    "confetti-js": "^0.0.18",
    "firebase": "8.10.0",
    "firebaseui": "^5.0.0",
    "immer": "^9.0.15",
    "localforage": "^1.9.0",
    "lodash": "^4.18.1",
    "node-emoji": "^1.10.0",
    "react": "^17",
    "react-ace": "^10.1.0",
    "react-contextmenu": "git://github.com/Roguelike-Celebration/react-contextmenu#master",
    "react-dom": "^17",
    "react-firebaseui": "^5.0.2",
    "react-icons": "^3.10.0",
    "react-linkify": "^1.0.0-alpha",
    "react-mentions": "^4.4.7",
    "react-page-visibility": "^6.4.0",
    "react-tooltip": "^4.2.8",
    "ts-node": "^10"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.27",
    "@types/node": "^24.19.2",
    "@types/node-emoji": "1.8.1",
    "@types/react": "^17",
    "@types/react-dom": "^17",
    "@types/react-linkify": "1.0.1",
    "@types/react-mentions": "4.1.6",
    "@types/react-page-visibility": "6.4.1",
    "@types/tracery-grammar": "^2.7.4",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "events": "^3.3.0",
    "https-browserify": "^1.0.0",
    "neostandard": "0.14.1",
    "parcel": "2.16.4",
    "process": "^0.11.10",
    "punycode": "^1.4.1",
    "querystring-es3": "^0.2.1",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "url": "^0.11.0",
    "util": "^0.12.4"
  }
}

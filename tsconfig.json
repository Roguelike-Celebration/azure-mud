{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["es2019", "DOM"],
    "strict": false,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "noImplicitReturns": true,
    "alwaysStrict": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "jsx": "react"
  },
  "ts-node": {
    "esm": true
  },
  "include": ["src/**/*", "lintLinks.ts"],
  "exclude": ["node_modules"]
}

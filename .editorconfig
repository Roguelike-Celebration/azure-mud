# Root .editorconfig for RLC MUD project

# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
charset = utf-8
indent_style = space
end_of_line = lf
insert_final_newline = true

[*.{ts,tsx,js,cjs,py,json,yml,html,css,sh,bash,zsh}]
indent_size = 2
tab_width = 2
trim_trailing_whitespace = true

[{tools/grin,tools/findd,tools/deploy,tools/lint-bash,tools/parcel_check}]
indent_size = 2
tab_width = 2
trim_trailing_whitespace = true

[*.md]
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true

[Makefile]
indent_style = tab
